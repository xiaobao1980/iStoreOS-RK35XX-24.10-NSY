test -n "${devtype}" || setenv devtype mmc

part uuid ${devtype} ${devnum}:2 uuid

# LubanCat 2N 调试串口固定 UART2 @ 1.5M（DTS stdout-path = "serial2:1500000n8"），
# 与 iStoreOS rk3568 默认引导波特率一致，无需像 K50S 那样另做 115200 变体。
# 无 JMS583 桥接盘（板载 SATA + mini-PCIe），故不加 usb-storage.quirks。
setenv bootargs "console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000 root=PARTUUID=${uuid} rw rootwait"

load ${devtype} ${devnum}:1 ${fdt_addr_r} rockchip.dtb
load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img

booti ${kernel_addr_r} - ${fdt_addr_r}
