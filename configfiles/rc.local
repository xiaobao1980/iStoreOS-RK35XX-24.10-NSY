# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# 以下代码是初始化nsy-g68-plus机型闭源WiFi功能的，不可删除否则WiFi不可用。
board_name() {
    [ -e /tmp/sysinfo/board_name ] && cat /tmp/sysinfo/board_name || echo "generic"
}

mtk_wifi() {
    local board=$(board_name)
    case "$board" in
        nsy,g68-plus)
            if [ -e /sys/class/net/ra0/queues/rx-0/rps_cpus ]; then
                wifi up
                sleep 5
                echo f > /sys/class/net/ra0/queues/rx-0/rps_cpus
                [ -e /sys/class/net/rax0/queues/rx-0/rps_cpus ] && echo f > /sys/class/net/rax0/queues/rx-0/rps_cpus
                [ -e /proc/sys/net/core/netdev_budget ] && echo 10000 > /proc/sys/net/core/netdev_budget
            fi
            ;;
        *)
            return 1
            ;;
    esac
}

# 初始化WiFi功能
mtk_wifi

# K50S/K50S MAX 兜底：lane1 (pcie3x1/fe270000) 的 RTL8125 链路训练慢，
# 若内核 link-wait 补丁仍未兜住，运行期周期性 rescan 把 0001:11:00.0 捞出来，
# 出现后 r8169 自动绑定并按 eth_order 命名 eth0（物理 LAN1）加入 br-lan（02_network 已含）。
pcie_lane1_rescan() {
    local board=$(board_name)
    case "$board" in
        roceos,k50s|roceos,k50s-max)
            (
            i=0
            while [ $i -lt 30 ]; do
                [ -d /sys/bus/pci/devices/0001:11:00.0 ] && break
                echo 1 > /sys/bus/pci/rescan
                i=$((i+1))
                sleep 2
            done
            logger -t pcie-rescan "lane1 RTL8125 0001:11:00.0 present after ${i} rescans"
            ) &
            ;;
    esac
}

pcie_lane1_rescan

# K50S/K50S MAX: netifd 启动（~30s）早于 eth_order 重命名完成（eth4 ~45s 才
# 出现），wan 会被标记 device-missing 后不再自动拉起（ifstatus up:false、
# udhcpc 不运行）。boot 末尾补一次 ifup 自愈；已 up 时为空操作。
k50s_wan_ifup() {
    local board=$(board_name)
    case "$board" in
        roceos,k50s|roceos,k50s-max)
            (
            sleep 3
            ifstatus wan 2>/dev/null | grep -q '"up": true' || ifup wan
            ifstatus wan6 2>/dev/null | grep -q '"up": true' || ifup wan6
            ) &
            ;;
    esac
}

k50s_wan_ifup

exit 0
