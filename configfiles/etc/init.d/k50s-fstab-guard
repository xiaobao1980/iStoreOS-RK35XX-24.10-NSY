#!/bin/sh /etc/rc.common
# ============================================================================
# K50S MAX fstab guard — 在 fstab init 服务之前运行，确保启动永不阻塞于 /dev/sda
# ----------------------------------------------------------------------------
# 根因：JMS583 USB-NVMe 桥（VID 152d PID 0583）在 M.2 不响应时 SCSI 命令 180s
#       超时；若 /etc/config/fstab 仍把 /dev/sda 当作 essential/根设备等待，
#       fstab init 服务会阻塞到 sda ready，导致启动被拖 10 多分钟。
#
# 本 init 脚本 START=05，早于 fstab(S12 左右) 执行，幂等中和 sda 启动依赖：
#   - 所有 device 含 sda 或 target 为 /overlay 或 / 的 mount 段：enabled=0，
#     并删除 is_rootfs。
#   - 关闭 @extroot 与 global anon_extroot / anon_mount。
#   - global delay_root 设为 0，防止 fstab 等待任何块设备。
#
# 仅对 roceos,k50s / roceos,k50s-max 生效。
# ============================================================================

START=05

boot() {
    # 早期 /tmp/sysinfo/board_name 可能还没生成，读 device-tree 兼容串
    local board=""
    if [ -r /proc/device-tree/compatible ]; then
        board=$(tr '\0' '\n' < /proc/device-tree/compatible | head -n1)
    fi
    case "$board" in
        roceos,k50s|roceos,k50s-max) ;;
        *) return 0 ;;
    esac

    [ -x /sbin/uci ] || return 0

    local changed=0

    for s in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.@mount\[\([0-9]*\)\].*/\1/p' | sort -u); do
        local dev=$(uci -q get fstab.@mount[$s].device 2>/dev/null)
        local tgt=$(uci -q get fstab.@mount[$s].target 2>/dev/null)
        if echo "$dev" | grep -q 'sda' || [ "$tgt" = "/overlay" ] || [ "$tgt" = "/" ]; then
            uci set fstab.@mount[$s].enabled='0'
            uci -q delete fstab.@mount[$s].is_rootfs
            changed=1
        fi
    done

    for g in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.@extroot\[\([0-9]*\)\].*/\1/p' | sort -u); do
        uci set fstab.@extroot[$g].enabled='0'
        changed=1
    done

    for gl in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.@global\[\([0-9]*\)\].*/\1/p' | sort -u); do
        if uci -q get fstab.@global[$gl].anon_extroot >/dev/null 2>&1; then
            uci set fstab.@global[$gl].anon_extroot='0'
            changed=1
        fi
        if uci -q get fstab.@global[$gl].anon_mount >/dev/null 2>&1; then
            uci set fstab.@global[$gl].anon_mount='0'
            changed=1
        fi
        uci set fstab.@global[$gl].delay_root='0'
        changed=1
    done

    if [ "$changed" = "1" ]; then
        uci commit fstab
        logger -t k50s-fstab-guard "disabled sda/overlay boot dependency and set delay_root=0"
    fi

    return 0
}
