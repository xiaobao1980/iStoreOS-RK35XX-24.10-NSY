#!/bin/sh /etc/rc.common
# ============================================================================
# K50S MAX r8125 驱动强制加载（启动中早段，绕过 iStoreOS disable_kmod）
# ----------------------------------------------------------------------------
# iStoreOS 把 r8125/r8168 当作“可选驱动”，默认不加载，并在启动中通过
# disable_kmod 机制卸载已加载的 r8125（约第 23 秒）。K50S 3 个 2.5G 网口是
# RTL8125B，必须由 r8125 驱动接管；否则启动后只有 2 个 GMAC 口。
#
# 本脚本在启动中早段（START=25，晚于 disable_kmod(23s) 与 kmodloader(27s)）
# 直接从 /lib/modules 中 insmod r8125（insmod 不走 modprobe 黑名单，可绕过
# disable_kmod 的黑名单）。加载成功后，在后台等待 eth0/eth1/eth2 出现、并等
# GMAC 重命名（eth3 出现）完成后重启 network，让 netifd 识别 2.5G 接口。
# 另起守护循环：若 r8125 被后续清理移除而 PCI 设备仍在，则自动重新加载。
#
# 仅对 roceos,k50s* 板型生效。
# ============================================================================

START=25

# 按 PCI / platform 设备路径把接口重命名为确定性名字。
# K50S MAX 三个 r8125 挂在不同 PCIe root port，probe 顺序会受 M.2 影响；
# 两个 GMAC 是平台设备，路径固定。按路径命名可保证 eth0-4 与机箱物理口一一对应。
k50s_get_iface_target() {
    local path="$1"
    case "$path" in
        *0001:11:00.0*) echo "eth0" ;;
        *0002:21:00.0*) echo "eth1" ;;
        *0000:01:00.0*) echo "eth2" ;;
        *fe010000.ethernet*) echo "eth3" ;;
        *fe2a0000.ethernet*) echo "eth4" ;;
        *) echo "" ;;
    esac
}

k50s_rename_interfaces() {
    local tmp="k50stmp"
    local idx=0
    local iface path target

    # 第一遍：把不在目标名上的接口先改到临时名，释放 eth0-4
    for iface in $(ls /sys/class/net 2>/dev/null); do
        [ -d "/sys/class/net/$iface/device" ] || continue
        path=$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)
        target=$(k50s_get_iface_target "$path")
        [ -n "$target" ] || continue
        [ "$iface" = "$target" ] && continue

        ip link set "$iface" down 2>/dev/null
        ip link set "$iface" name "${tmp}${idx}" 2>/dev/null && {
            logger -t k50s-r8125-enable "tmp rename $iface ($path) -> ${tmp}${idx}"
            idx=$((idx+1))
        } || logger -t k50s-r8125-enable "failed tmp rename $iface ($path)"
    done

    # 第二遍：把临时名接口按设备路径改到最终目标名
    for iface in $(ls /sys/class/net 2>/dev/null); do
        case "$iface" in ${tmp}*) ;; *) continue ;; esac
        path=$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)
        target=$(k50s_get_iface_target "$path")
        [ -n "$target" ] || {
            logger -t k50s-r8125-enable "unknown path for tmp $iface: $path"
            continue
        }
        ip link set "$iface" down 2>/dev/null
        ip link set "$iface" name "$target" 2>/dev/null && \
            logger -t k50s-r8125-enable "renamed $iface -> $target ($path)" || \
            logger -t k50s-r8125-enable "failed rename $iface -> $target ($path)"
    done
}

boot() {
    local board=""
    if [ -r /proc/device-tree/compatible ]; then
        board=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | tr '[:upper:]' '[:lower:]')
    fi
    case "$board" in
        *k50s*) ;;
        *) return 0 ;;
    esac

    if lsmod 2>/dev/null | grep -q "^r8125 "; then
        logger -t k50s-r8125-enable "r8125 already loaded"
        return 0
    fi

    local ko=$(find /lib/modules -name "r8125.ko" 2>/dev/null | head -n1)
    if [ -z "$ko" ]; then
        logger -t k50s-r8125-enable "WARN: r8125.ko not found in /lib/modules"
        return 0
    fi

    logger -t k50s-r8125-enable "loading $ko with aspm=0"
    if ! insmod "$ko" aspm=0 2>/dev/null; then
        logger -t k50s-r8125-enable "WARN: insmod r8125 failed (may already be claimed by r8169)"
        return 0
    fi

    logger -t k50s-r8125-enable "r8125 loaded successfully, configuring ports in background"

    # 所有重活放进后台，boot() 立即返回，不阻塞开机
    (
        # 等待 3 个 r8125 接口出现（此时名字还不固定，不能按 eth0/1/2 判断）
        count=0
        for i in $(seq 1 30); do
            count=0
            for iface in $(ls /sys/class/net 2>/dev/null); do
                [ -d "/sys/class/net/$iface/device" ] || continue
                [ "$(cat /sys/class/net/$iface/device/driver 2>/dev/null | xargs basename 2>/dev/null)" = "r8125" ] && count=$((count+1))
            done
            [ "$count" -ge 3 ] && break
            sleep 1
        done
        [ "$count" -lt 3 ] && logger -t k50s-r8125-enable "WARN: only $count r8125 interfaces found, rename may be incomplete"

        # 按 PCI / platform 路径重命名所有接口，确保 eth0-4 与物理口一致
        k50s_rename_interfaces

        logger -t k50s-r8125-enable "restarting network to pick up 2.5G ports"
        /etc/init.d/network restart

        # 守护：若 r8125 被后续清理移除且 PCI 设备仍在，则重新加载
        while true; do
            sleep 30
            if [ -d /sys/bus/pci/devices/0000:01:00.0 ] && ! lsmod 2>/dev/null | grep -q "^r8125 "; then
                local k=$(find /lib/modules -name "r8125.ko" 2>/dev/null | head -n1)
                if [ -n "$k" ] && insmod "$k" aspm=0 2>/dev/null; then
                    logger -t k50s-r8125-enable "re-loaded r8125 (watchdog)"
                    /etc/init.d/network restart
                fi
            fi
        done
    ) &

    return 0
}
