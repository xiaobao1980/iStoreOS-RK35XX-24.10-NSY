#!/bin/sh /etc/rc.common
# ============================================================================
# K50S MAX r8125 驱动强制加载（启动末，绕过 iStoreOS disable_kmod）
# ----------------------------------------------------------------------------
# iStoreOS 把 r8125/r8168 当作“可选驱动”，默认不加载，并在启动中通过
# disable_kmod 机制卸载已加载的 r8125。K50S 3 个 2.5G 网口是 RTL8125B，
# 必须由 r8125 驱动接管；否则启动后只有 2 个 GMAC 口。
#
# 本脚本在启动快结束时（START=99）检查 r8125 是否已加载，若未加载则
# 直接从 /lib/modules 中 insmod。同时把模块参数 aspm=0，避免部分 8125B
# 在低功耗模式下掉线/协商异常。
#
# 加载成功后，在后台等待 eth0/eth1/eth2 出现并重启 network，使 netifd
# 重新识别 2.5G 接口。
#
# 仅对 roceos,k50s* 板型生效。
# ============================================================================

START=99

boot() {
    local board=""
    if [ -r /proc/device-tree/compatible ]; then
        board=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | tr '[:upper:]' '[:lower:]')
    fi
    case "$board" in
        *k50s*) ;;
        *) return 0 ;;
    esac

    if lsmod 2>/dev/null | grep -q "^r8125 "; then
        logger -t k50s-r8125-enable "r8125 already loaded"
        return 0
    fi

    local ko=$(find /lib/modules -name "r8125.ko" 2>/dev/null | head -n1)
    if [ -z "$ko" ]; then
        logger -t k50s-r8125-enable "WARN: r8125.ko not found in /lib/modules"
        return 0
    fi

    logger -t k50s-r8125-enable "loading $ko with aspm=0"
    if ! insmod "$ko" aspm=0 2>/dev/null; then
        logger -t k50s-r8125-enable "WARN: insmod r8125 failed (may already be claimed by r8169)"
        return 0
    fi

    logger -t k50s-r8125-enable "r8125 loaded successfully, will restart network once interfaces appear"

    # 后台等待接口出现，然后重启 network，避免阻塞 boot 末段
    (
        for i in $(seq 1 15); do
            [ -d /sys/class/net/eth0 ] && [ -d /sys/class/net/eth1 ] && [ -d /sys/class/net/eth2 ] && break
            sleep 1
        done
        logger -t k50s-r8125-enable "restarting network after r8125 load"
        /etc/init.d/network restart
    ) &

    return 0
}
