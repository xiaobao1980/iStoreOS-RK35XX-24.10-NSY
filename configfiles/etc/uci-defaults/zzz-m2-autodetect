#!/bin/sh
# ============================================================================
# zzz-m2-autodetect  —  K50S MAX：保证拔掉 M.2 也能快速启动
# ----------------------------------------------------------------------------
# 根因：K50S MAX 的 M.2 走 USB3.0 UAS 桥 JMS583（VID 152d PID 0583），识别为
#       /dev/sda。M.2 不响应时块设备节点仍被枚举，但读写触发 SCSI 命令 180s 超时。
#
#       block-mount 启动期自动挂载由 fstab 全局开关控制，现代 OpenWrt/iStoreOS
#       真正生效的是 option auto_mount '1'（默认开）。auto_mount=1 时 fstab init
#       会在启动期探测并挂载 /dev/sda，卡在 180s×N 的 SCSI 超时里，启动被拖 10+
#       分钟。此外若 fstab 把 /dev/sda 配成 extroot/overlay 根，preinit mount_root
#       也会等待 sda ready 而卡住。
#
# 本脚本（首次启动 uci-defaults，幂等）做三件事：
#   1) 中和任何把 /dev/sda 当作“启动根”的 fstab 条目（is_rootfs=1 / target=/overlay
#      / target=/ 或 device 含 sda）：enabled=0 并删除 is_rootfs。
#      -> 【有无 M.2 都能进入系统】。
#   2) 关闭 fstab 全局的 anon_extroot / anon_mount / auto_mount / anon_swap /
#      auto_swap，并把 delay_root 设为 0，确保 fstab init 服务不会因等待/探测
#      M.2（或任何块设备）而阻塞启动。
#   3) 不做任何会让启动依赖 M.2 的配置；M.2 的“识别与使用”交给
#      hotplug 脚本 /etc/hotplug.d/block/30-m2-automount（插上即挂 /mnt/m2）。
#
# 仅对 roceos,k50s / roceos,k50s-max 生效，其它型号忽略。
# ============================================================================
[ -x /sbin/uci ] || exit 0

board=$(cat /tmp/sysinfo/board_name 2>/dev/null)
case "$board" in
  roceos,k50s|roceos,k50s-max) ;;
  *) exit 0 ;;
esac

changed=0

# 1) 中和所有“启动依赖 M.2”的 mount 段（含 is_rootfs 外部根）
for s in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.@mount\[\([0-9]*\)\].*/\1/p' | sort -u); do
  dev=$(uci -q get fstab.@mount[$s].device 2>/dev/null)
  tgt=$(uci -q get fstab.@mount[$s].target 2>/dev/null)
  rootfs=$(uci -q get fstab.@mount[$s].is_rootfs 2>/dev/null)
  if echo "$dev" | grep -q 'sda' || [ "$tgt" = "/overlay" ] || [ "$tgt" = "/" ] || [ "$rootfs" = "1" ]; then
    uci set fstab.@mount[$s].enabled='0'
    uci -q delete fstab.@mount[$s].is_rootfs
    changed=1
  fi
done

# 2) 关闭显式 extroot 段（避免 preinit 仍尝试外部根）
for g in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.@extroot\[\([0-9]*\)\].*/\1/p' | sort -u); do
  uci set fstab.@extroot[$g].enabled='0'
  changed=1
done

# 3) 全局：关闭启动期自动挂载/交换与外部根，等待根设备时间置 0
#    auto_mount 为真正生效的自动挂载开关（默认 1），必须置 0
for gl in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.@global\[\([0-9]*\)\].*/\1/p' | sort -u); do
  uci set fstab.@global[$gl].anon_extroot='0'
  uci set fstab.@global[$gl].anon_mount='0'
  uci set fstab.@global[$gl].auto_mount='0'
  uci set fstab.@global[$gl].anon_swap='0'
  uci set fstab.@global[$gl].auto_swap='0'
  # 关键：fstab init 等待根/essential 设备的最长时间，0 表示不阻塞启动
  uci set fstab.@global[$gl].delay_root='0'
  changed=1
done

[ "$changed" = "1" ] && uci commit fstab

# 确保数据盘挂载点存在（hotplug 会用到）
mkdir -p /mnt/m2

# 启用每次启动早期运行的 fstab guard（比 fstab init 服务更早）
if [ -x /etc/init.d/k50s-fstab-guard ]; then
    /etc/init.d/k50s-fstab-guard enable
fi

exit 0
